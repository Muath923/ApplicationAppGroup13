function Toast({ message, show }: { message: string; show: boolean }) {
  if (!show) return null;
  return (
    <div
      style={{
        position: "fixed",
        bottom: 30,
        left: "50%",
        transform: "translateX(-50%)",
        background: "linear-gradient(135deg, #7c6bc4, #a78bfa)",
        color: "#fff",
        padding: "14px 28px",
        borderRadius: 14,
        fontSize: 14,
        fontWeight: 600,
        boxShadow: "0 8px 32px #7c6bc440",
        zIndex: 999,
        backdropFilter: "blur(10px)",
        animation: "fadeInUp 0.35s cubic-bezier(0.16,1,0.3,1)",
        maxWidth: 380,
        textAlign: "center",
      }}
    >
      {message}
    </div>
  );
}

