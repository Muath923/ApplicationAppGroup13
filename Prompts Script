        boxShadow:
          "0 4px 20px rgba(124,107,196,0.08), 0 1px 3px rgba(0,0,0,0.04)",
        transition: "transform 0.2s, box-shadow 0.2s",
        cursor: onClick ? "pointer" : "default",
        ...style,
      }}
    >
      {children}
    </div>
  );
}

